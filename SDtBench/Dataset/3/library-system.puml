@startuml
skinparam classAttributeIconSize 0
title Library System Class Diagram
class Book as "Book"
class Author as "Author"
class Member as "Member"
class Loan as "Loan"
class Librarian as "Librarian"
class Fine as "Fine"
class Publisher as "Publisher"
class Copy as "Copy"
