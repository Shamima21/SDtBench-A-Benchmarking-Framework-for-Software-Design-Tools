digraph UniversityPortal {
  rankdir=LR;
  labelloc="t";
  label="University Portal — Entity Graph";
  node [shape=box, style=rounded];
  "Student";
  "Course";
  "Professor";
  "Department";
  "Exam";
  "Grade";
  "Assignment";
  "Library";
  "Schedule";
  "Club";
  "Student" -> "Course" [label="enrollsIn"];
  "Professor" -> "Course" [label="teaches"];
  "Course" -> "Department" [label="offeredBy"];
  "Course" -> "Assignment" [label="has"];
  "Assignment" -> "Grade" [label="gradedAs"];
  "Student" -> "Assignment" [label="submits"];
  "Student" -> "Exam" [label="takes"];
  "Exam" -> "Course" [label="for"];
  "Grade" -> "Exam" [label="awardedFor"];
  "Library" -> "Course" [label="provides"];
  "Student" -> "Library" [label="borrowsFrom"];
  "Schedule" -> "Course" [label="allocates"];
  "Schedule" -> "Professor" [label="assignedTo"];
  "Student" -> "Schedule" [label="follows"];
  "Club" -> "Department" [label="belongsTo"];
  "Student" -> "Club" [label="joins"];
}