@startuml
skinparam classAttributeIconSize 0
title Banking System Class Diagram
class Account as "Account"
class Customer as "Customer"
class Transaction as "Transaction"
class Loan as "Loan"
class CreditCard as "CreditCard"
class ATM as "ATM"
class Branch as "Branch"
class Employee as "Employee"
