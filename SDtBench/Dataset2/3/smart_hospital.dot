digraph SmartHospital {
  rankdir=LR;
  labelloc="t";
  label="Smart Hospital — Entity Graph";
  node [shape=box, style=rounded];
  "Patient";
  "Doctor";
  "Nurse";
  "Ward";
  "Appointment";
  "Surgery";
  "Prescription";
  "LabTest";
  "Pharmacy";
  "Invoice";
  "Insurance";
  "Ambulance";
  "Device";
  "Record";
  "Billing";
  "Emergency";
  "Department";
  "Staff";
  "Schedule";
  "Room";
  "Patient" -> "Appointment" [label="schedules"];
  "Appointment" -> "Doctor" [label="with"];
  "Appointment" -> "Nurse" [label="assistedBy"];
  "Appointment" -> "Surgery" [label="mayLeadTo"];
  "Surgery" -> "Schedule" [label="scheduledVia"];
  "Surgery" -> "Doctor" [label="performedBy"];
  "Patient" -> "Ward" [label="admittedTo"];
  "Patient" -> "Room" [label="assignedTo"];
  "Room" -> "Ward" [label="partOf"];
  "Doctor" -> "Prescription" [label="prescribes"];
  "Prescription" -> "Pharmacy" [label="dispensedBy"];
  "Doctor" -> "LabTest" [label="orders"];
  "LabTest" -> "Patient" [label="for"];
  "Ambulance" -> "Emergency" [label="transportsTo"];
  "Emergency" -> "Patient" [label="triages"];
  "Device" -> "Patient" [label="monitors"];
  "Device" -> "Department" [label="managedBy"];
  "Record" -> "Patient" [label="records"];
  "Record" -> "Appointment" [label="includes"];
  "Record" -> "Surgery" [label="includes"];
  "Record" -> "LabTest" [label="includes"];
  "Record" -> "Prescription" [label="includes"];
  "Billing" -> "Invoice" [label="generates"];
  "Invoice" -> "Patient" [label="issuedFor"];
  "Insurance" -> "Invoice" [label="covers"];
  "Billing" -> "Patient" [label="billedTo"];
  "Department" -> "Staff" [label="employs"];
  "Staff" -> "Department" [label="assignedTo"];
  "Schedule" -> "Doctor" [label="allocatedFor"];
  "Schedule" -> "Nurse" [label="allocatedFor"];
  "Schedule" -> "Room" [label="reserves"];
}