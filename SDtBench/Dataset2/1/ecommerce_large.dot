digraph ECommerceLarge {
  rankdir=LR;
  labelloc="t";
  label="Large E-commerce Platform — Entity Graph";
  node [shape=box, style=rounded];
  "Customer";
  "Product";
  "Category";
  "Order";
  "Payment";
  "Invoice";
  "Review";
  "Cart";
  "Shipment";
  "Supplier";
  "Return";
  "Refund";
  "Employee";
  "Promotion";
  "Warehouse";
  "Stock";
  "LoyaltyCard";
  "Notification";
  "Report";
  "Analytics";
  "Customer" -> "Order" [label="places"];
  "Customer" -> "Cart" [label="owns"];
  "Customer" -> "LoyaltyCard" [label="holds"];
  "Cart" -> "Product" [label="contains"];
  "Order" -> "Product" [label="includes"];
  "Order" -> "Invoice" [label="generates"];
  "Order" -> "Payment" [label="settledBy"];
  "Order" -> "Shipment" [label="shippedAs"];
  "Order" -> "Promotion" [label="applies"];
  "Product" -> "Supplier" [label="providedBy"];
  "Product" -> "Category" [label="categorizedAs"];
  "Product" -> "Stock" [label="trackedBy"];
  "Product" -> "Warehouse" [label="storedIn"];
  "Stock" -> "Warehouse" [label="keptAt"];
  "Shipment" -> "Customer" [label="deliveredTo"];
  "Shipment" -> "Return" [label="mayLeadTo"];
  "Return" -> "Refund" [label="resultsIn"];
  "Customer" -> "Review" [label="writes"];
  "Review" -> "Product" [label="about"];
  "Notification" -> "Customer" [label="informs"];
  "Notification" -> "Order" [label="about"];
  "Promotion" -> "Product" [label="appliesTo"];
  "Employee" -> "Warehouse" [label="manages"];
  "Employee" -> "Report" [label="creates"];
  "Analytics" -> "Order" [label="aggregatesFrom"];
  "Analytics" -> "Product" [label="aggregatesFrom"];
  "Report" -> "Analytics" [label="summarizes"];
}